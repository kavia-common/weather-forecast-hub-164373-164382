# Public env vars for React must be prefixed with REACT_APP_
# Replace with your weather API base URL and key (e.g., OpenWeatherMap)
REACT_APP_WEATHER_API_BASE=https://api.openweathermap.org/data/2.5
REACT_APP_WEATHER_API_KEY=YOUR_API_KEY_HERE

# City autocomplete/geocoding API (if using OpenWeather Geocoding)
REACT_APP_GEOCODING_API_BASE=https://api.openweathermap.org/geo/1.0

# Optional: Site URL for auth or redirects (reserved, not used now)
REACT_APP_SITE_URL=http://localhost:3000
